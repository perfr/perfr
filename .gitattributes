# Keep sources that are embedded with include_str! as LF. A Windows
# checkout with core.autocrlf otherwise turns the skill front matter
# into CRLF and the embedded-skill test fails.
*.md text eol=lf
*.rs text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.wgsl text eol=lf

# Parser fixtures are kept byte for byte. Three of the .cpp files here are
# stored with CRLF, which the *.cpp rule above forbids, so git reported
# them as modified in every fresh checkout. They are the sources of
# binaries that are already built and committed; nothing reads them.
crates/perfr-object/testdata/** -text
